# Keep the build context small: the datasets alone are several gigabytes.
.git
# Secrets, such as Neon's connection strings in .env.local, never go to the builder.
.env*
.neon
data/
results/
backend/tests/
**/node_modules
**/dist
**/.venv
**/__pycache__
**/*.egg-info
**/.pytest_cache
**/.ruff_cache
