# Copy to .env to override defaults. Nothing here is required to start the app.

# Local database password. Docker Compose uses a development default when unset.
# POSTGRES_PASSWORD=

# Switches on the conversation with Claude. Set a spending limit on the key in the Anthropic
# Console too.
# ANTHROPIC_API_KEY=

# Settings for a hosted copy. Set them in your host's environment, not in this file.
# DATABASE_URL=postgresql://user:password@host:5432/movie_app
# PUBLIC_HOSTS=your-app.example.com
# CLIENT_IP_HEADER=Fly-Client-IP     # the host proxy's visitor-address header, never X-Forwarded-For
# DAILY_SPEND_LIMIT_USD=5            # chat pauses until midnight UTC once Claude costs this much
# CHAT_MESSAGES_PER_HOUR=30          # per visitor
# REQUESTS_PER_MINUTE=120            # per visitor, for searches, quick picks and MCP
# CONVERSATION_RETENTION_DAYS=30
